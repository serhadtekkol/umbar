    "settings.clipboard.toggle.detail" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text, links and images you copy appear on the Shelf page under Clipboard. Click one to copy it again. Items that apps mark as private or concealed, and copies from known password managers and the apps you exclude below, are not saved. Turning this off deletes the history."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopyaladığın metin, bağlantı ve görseller Raf sayfasında Pano altında görünür. Birine tıklayınca yeniden kopyalanır. Uygulamaların gizli olarak işaretlediği öğeler ile bilinen parola yöneticilerinden ve aşağıda hariç tuttuğun uygulamalardan yapılan kopyalar kaydedilmez. Kapatınca geçmiş silinir."
          }
        }
      }
