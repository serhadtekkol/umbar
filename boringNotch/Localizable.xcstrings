    "netmonitor.settings.wifiName.detail" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS only reveals the Wi-Fi name to apps with Location access. umbar uses that access for the name alone and never reads your location. Without it the network is shown as “This network (Wi-Fi)”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS, Wi-Fi adını yalnızca Konum Servisleri erişimi olan uygulamalara verir. umbar bu erişimi yalnızca ad için kullanır ve konumunuzu hiç okumaz. Erişim olmadan ağ “Bu ağ (Wi-Fi)” olarak gösterilir."
          }
        }
