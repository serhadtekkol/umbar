    "Keeps the Mac and its display awake. Choose the length in the notch: until you turn it off, 15 minutes, 1 hour or 2 hours." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeps the Mac and its display awake. Choose the length in the notch: until you turn it off, 15 minutes, 1 hour or 2 hours."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac'i ve ekranını uyanık tutar. Süreyi notch'tan seçin: siz kapatana kadar, 15 dakika, 1 saat ya da 2 saat."
          }
        }
      }
    },
