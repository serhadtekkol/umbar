    "The 25/5 and 50/10 presets are fixed. The third button in the notch uses your custom times. While a focus session runs, eye-break reminders wait for the break." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The 25/5 and 50/10 presets are fixed. The third button in the notch uses your custom times. While a focus session runs, eye-break reminders wait for the break."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "25/5 ve 50/10 ön ayarları sabittir. Notch'taki üçüncü düğme özel sürelerinizi kullanır. Odak oturumu sürerken göz molası anımsatıcıları molayı bekler."
          }
        }
      }
