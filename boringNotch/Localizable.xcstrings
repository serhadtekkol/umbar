    "edgeGlow.settings.audio" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "React to sound"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sese tepki ver"
          }
        }
      }
    },
    "edgeGlow.settings.audio.detail" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While music plays, the glow follows how loud it is and widens on the bass. umbar measures only the loudness: of the app playing the music, or of all system sound if it cannot find that app. Nothing is recorded or sent anywhere. While the microphone is in use, as in a call, system sound is not measured. macOS asks you to allow audio recording for umbar. Off by default."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Müzik çalarken parıltı sesin yüksekliğini izler, baslarda biraz genişler. umbar yalnızca yüksekliği ölçer: müziği çalan uygulamanın, o bulunamazsa tüm sistem sesinin. Ses kaydedilmez, hiçbir yere gönderilmez. Mikrofon kullanımdayken (örneğin bir görüşmede) sistem sesi dinlenmez. macOS, umbar'a ses kaydı izni vermenizi ister. Varsayılan olarak kapalıdır."
          }
        }
      }
    },
    "edgeGlow.settings.audio.denied" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio recording is off for umbar, so the glow breathes instead."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "umbar için ses kaydı izni kapalı; parıltı bunun yerine nefes alıyor."
          }
        }
      }
    },
    "edgeGlow.settings.audio.open" : {
