{
  "sourceLanguage": "en",
  "strings": {
    "NSAppleEventsUsageDescription": {
      "comment": "Apple Events permission prompt: why umbar talks to Music and Spotify.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "umbar uses Apple Events to read what Music and Spotify are playing, to control playback and volume from the notch, and to switch Dark Mode from the quick toggles."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "umbar, Müzik ve Spotify'da çalanı okumak, çalmayı ve ses düzeyini notch'tan denetlemek ve hızlı ayarlardan Karanlık Mod'u değiştirmek için Apple Events kullanır."
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "comment": "Calendar permission prompt (full access, macOS 14 and later).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "umbar shows your calendar events in the notch. Your events never leave your Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "umbar, takvim etkinliklerinizi notch'ta gösterir. Etkinlikleriniz Mac'inizden hiç çıkmaz."
          }
        }
      }
    },
    "NSCalendarsUsageDescription": {
      "comment": "Calendar permission prompt (legacy key, same text as the full-access key).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "umbar shows your calendar events in the notch. Your events never leave your Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "umbar, takvim etkinliklerinizi notch'ta gösterir. Etkinlikleriniz Mac'inizden hiç çıkmaz."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "comment": "Camera permission prompt: the opt-in mirror tile on the Now page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "umbar shows your camera in the notch as a mirror, only after you tap the mirror tile. The picture is shown live and is never recorded, saved or sent anywhere."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "umbar, kamera görüntünüzü notch'ta ayna olarak gösterir; yalnızca ayna kutucuğuna dokunduğunuzda açılır. Görüntü canlı gösterilir; hiçbir zaman kaydedilmez, saklanmaz ve hiçbir yere gönderilmez."
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription": {
      "comment": "Reminders permission prompt (full access). Must say umbar also writes completion (AC-6R.7).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "umbar lists your reminders next to your events in the notch. When you check a reminder off there, or uncheck it, umbar saves that change to Reminders. Your reminders never leave your Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "umbar, anımsatıcılarınızı notch'ta etkinliklerinizin yanında listeler. Orada bir anımsatıcıyı tamamlandı olarak işaretlediğinizde ya da işareti kaldırdığınızda bu değişikliği Anımsatıcılar'a kaydeder. Anımsatıcılarınız Mac'inizden hiç çıkmaz."
          }
        }
      }
    },
    "NSRemindersUsageDescription": {
      "comment": "Reminders permission prompt (legacy key, same text as the full-access key). Must say umbar also writes completion (AC-6R.7).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "umbar lists your reminders next to your events in the notch. When you check a reminder off there, or uncheck it, umbar saves that change to Reminders. Your reminders never leave your Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "umbar, anımsatıcılarınızı notch'ta etkinliklerinizin yanında listeler. Orada bir anımsatıcıyı tamamlandı olarak işaretlediğinizde ya da işareti kaldırdığınızda bu değişikliği Anımsatıcılar'a kaydeder. Anımsatıcılarınız Mac'inizden hiç çıkmaz."
          }
        }
      }
    },
    "NSAudioCaptureUsageDescription": {
      "comment": "System audio capture prompt: the edge glow's audio-reactive mode. Only loudness is computed, in memory; the all-system fallback is skipped while another app uses the microphone.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "umbar measures how loud the music you play is, so the glow around the notch can move with it. When it cannot tell which app is playing, it measures the loudness of all system sound instead, but never while another app is using the microphone. Only the loudness is measured, in memory; the sound itself is never recorded, saved or sent anywhere."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "umbar, notch çevresindeki ışığın müzikle birlikte hareket edebilmesi için çaldığınız müziğin ses yüksekliğini ölçer. Hangi uygulamanın çaldığını ayırt edemezse onun yerine tüm sistem sesinin yüksekliğini ölçer; başka bir uygulama mikrofonu kullanırken bunu hiçbir zaman yapmaz. Yalnızca ses yüksekliği bellekte ölçülür; sesin kendisi hiçbir zaman kaydedilmez, saklanmaz ya da bir yere gönderilmez."
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription": {
      "comment": "Bluetooth permission prompt: quick toggles list paired devices.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "umbar lists your paired Bluetooth devices so you can connect headphones from the notch."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "umbar, kulaklığınızı notch'tan bağlayabilmeniz için eşlenmiş Bluetooth aygıtlarınızı listeler."
          }
        }
      }
    },
    "NSFocusStatusUsageDescription": {
      "comment": "Focus status permission prompt: quick toggles show whether a Focus is on.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "umbar shows whether a Focus is on in the notch's quick toggles."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "umbar, notch'taki hızlı ayarlarda bir Odak modunun açık olup olmadığını gösterir."
          }
        }
      }
    },
    "NSLocationUsageDescription": {
      "comment": "Location prompt: used only to read the Wi-Fi name for network traffic labels.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "umbar reads the Wi-Fi name to label your network traffic totals. Your location is never used or stored."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "umbar, ağ trafiği toplamlarını etiketlemek için Wi-Fi adını okur. Konumunuz hiçbir zaman kullanılmaz ya da saklanmaz."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "comment": "Location prompt: used only to read the Wi-Fi name for network traffic labels.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "umbar reads the Wi-Fi name to label your network traffic totals. Your location is never used or stored."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "umbar, ağ trafiği toplamlarını etiketlemek için Wi-Fi adını okur. Konumunuz hiçbir zaman kullanılmaz ya da saklanmaz."
          }
        }
      }
    }
  },
  "version": "1.0"
}